---
import { getCollection } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(post => !post.data.draft)
    .map(post => ({
      params: { slug: post.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  tags,
  category,
  audio,
  relatedPosts,
} = post.data;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  author={author}
>
  <article class="mx-auto max-w-3xl px-4 py-16 lg:px-8">
    <header class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 text-primary hover:underline"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>
        Back to blog
      </a>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-primary/10 px-3 py-1 text-sm font-medium text-primary">
          {category}
        </span>
        <time datetime={pubDate.toISOString()} class="text-sm text-text-muted">
          {pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {updatedDate && (
          <span class="text-sm text-text-muted">
            (Updated {updatedDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })})
          </span>
        )}
      </div>

      <h1 class="mt-6 text-4xl font-bold font-serif leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-xl text-text-muted">{description}</p>

      <div class="mt-6 flex items-center gap-2 text-sm text-text-muted">
        <span>By {author}</span>
      </div>

      {audio && (
        <div class="mt-6">
          <AudioPlayer
            src={audio.src}
            title={`${title} - Audio`}
            duration={audio.duration}
          />
        </div>
      )}

      {tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {tags.map(tag => (
            <a
              href={`/blog?tag=${tag}`}
              class="rounded-full bg-background border border-border px-3 py-1 text-sm text-text-muted hover:text-primary hover:border-primary"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <Content />
    </div>

    <footer class="mt-16 border-t border-border pt-8">
      <div class="mb-8">
        <h3 class="mb-4 text-lg font-semibold">Share this post</h3>
        <div class="flex gap-3">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(
              Astro.url.href,
            )}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm hover:bg-primary hover:text-background hover:border-primary transition-colors"
          >
            Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(
              Astro.url.href,
            )}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm hover:bg-primary hover:text-background hover:border-primary transition-colors"
          >
            LinkedIn
          </a>
        </div>
      </div>

      {relatedPosts && relatedPosts.length > 0 && (
        <div>
          <h3 class="mb-4 text-lg font-semibold">Related Posts</h3>
          <ul class="space-y-2">
            {relatedPosts.map((relatedSlug: string) => (
              <li>
                <a
                  href={`/blog/${relatedSlug}`}
                  class="text-primary hover:underline"
                >
                  {relatedSlug}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </footer>
  </article>
</BaseLayout>
